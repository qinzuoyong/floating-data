# R8 保留规则 — 电池温度悬浮窗
# 前台 Service 不被混淆
-keep class com.example.batteryfloat.service.FloatingWindowService { *; }

# 开机广播接收器不被混淆
-keep class com.example.batteryfloat.receiver.BootReceiver { *; }

# 电池监控器保持回调接口
-keep class com.example.batteryfloat.monitor.BatteryMonitor$* { *; }
# ADB 无线调试(批次 2):JNI RegisterNatives 按类名绑定,不可混淆/改名
-keep class com.example.batteryfloat.adb.AdbPairingClient { *; }
-keep class com.example.batteryfloat.adb.PairingContext { *; }
# Gson 反射序列化
-keep class com.google.gson.reflect.TypeToken { *; }
-keep class * extends com.google.gson.reflect.TypeToken
-keepattributes Signature
-keepattributes *Annotation*
# 信令协议数据类（Gson 反序列化目标）
# 信令/存储/定位数据类（Gson 反序列化目标）
-keep class com.example.batteryfloat.p2p.** { *; }
-keep class com.example.batteryfloat.family.** { *; }
-keep class com.example.batteryfloat.location.** { *; }
# 百度地图 SDK
-keep class com.baidu.** { *; }
-dontwarn com.baidu.**