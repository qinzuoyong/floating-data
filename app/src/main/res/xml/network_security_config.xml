<?xml version="1.0" encoding="utf-8"?>
<!-- 家人位置共享：信令已迁到自有的 WSS 端点（2026-09-27），故不再放行任何信令服务器的明文；
     以下明文放行只服务于家人地图的 WebView（百度地图 JS/瓦片与其 Referer 载体） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- 信令故障兜底端点（非本机所有；仅在主端点不可达时才会连到，明文 ws） -->
        <domain includeSubdomains="false">47.94.212.176</domain>
        <!-- 家人共享地图 WebView 的 Referer 载体域名（baseURL，仅作来源标识，不实际访问） -->
        <domain includeSubdomains="false">familymap.gcdar.com</domain>
        <!-- 百度 JS API 的 qt=verify / 错误上报走 http 明文（getscript 内部硬编码），需放行 -->
        <domain includeSubdomains="false">api.map.baidu.com</domain>
        <!-- 百度地图瓦片域名 apimaponline0-3.bdimg.com（http 明文），放行全部子域 -->
        <domain includeSubdomains="true">bdimg.com</domain>
    </domain-config>
</network-security-config>