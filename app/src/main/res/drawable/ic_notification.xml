    <!-- 通知栏小图标：必须紧凑铺满 24dp 画布。
         不能复用 ic_launcher_foreground——那是自适应图标前景，内容只占 108dp 画布的
         中央安全区（约 66/108），直接用作通知图标会被缩得几乎看不见。
         系统按 alpha 蒙版渲染为纯白，故此处只用白色填充、不留背景。 -->

    <!-- 正极帽 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10,2 h4 a1,1 0 0 1 1,1 v2 h-6 v-2 a1,1 0 0 1 1,-1 z" />

    <!-- 电池主体（描边） -->
